@startuml
!pragma layout smetana
left to right direction
skinparam shadowing false
skinparam dpi 130
skinparam defaultFontName Arial
skinparam usecase {
  BackgroundColor White
  BorderColor Black
}
skinparam rectangle {
  BackgroundColor White
  BorderColor Black
}
title Процесс 6-MAR «Маркетинг и акции»

actor "Маркетолог" as Mkt
actor "Директор сети" as Dir

rectangle "Маркетинг и акции (6-MAR)" {
  usecase "Управлять акциями" as U61
  usecase "Просмотреть эффективность\nакции" as U62
  usecase "Настроить правила\nнапоминаний" as U63
  usecase "Рассчитать стоимость\n(процесс 1-AB)" as U14
  usecase "Применить скидку\nпо акции\n(процесс 1-AB)" as U18
}

Mkt -- U61
Dir -- U61
Mkt -- U62
Dir -- U62
Mkt -- U63
U18 .> U14 : <<extend>>
@enduml
